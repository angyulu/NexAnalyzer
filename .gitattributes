# Normalize text files to LF in the repository, checked out per-platform.
* text=auto

# The macOS/Linux launcher must be LF even when cloned on Windows -- a CRLF
# shebang line fails with "bad interpreter: /bin/bash^M".
*.sh text eol=lf

# The Windows launcher stays CRLF everywhere.
*.bat text eol=crlf

# Binary assets git must not touch.
*.xlsx binary
*.pptx binary
*.png binary
*.bmp binary
*.jpg binary
*.tif binary

# The installer is downloaded straight from raw.githubusercontent.com, which
# serves the stored blob and ignores the eol rules above. Store its bytes
# verbatim so the download is CRLF, which cmd.exe parses without edge cases.
Install-NexAnalyzer.bat -text
