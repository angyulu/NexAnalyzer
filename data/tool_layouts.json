{
  "schema_version": 1,
  "layouts": {
    "HA1P01": {
      "optical": {
        "subfolder": "OPTICALS",
        "patterns": [
          "OPTICALS/*/{wafer}",
          "OPTICALS/*/{wafer}*.wip"
        ]
      },
      "runcard": {
        "subfolder": "RUNCARD/lcy/NSHA1P01",
        "patterns": [
          "RUNCARD/lcy/NSHA1P01/*/{wafer}.csv"
        ]
      },
      "datalog": {
        "subfolder": "DATALOG",
        "patterns": [
          "DATALOG/*/*~{wafer}.csv"
        ],
        "tag_index": "DATALOG/runcard_tags.json"
      },
      "exclude": ["BACKUP"]
    }
  }
}
